<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <AppVersion>1.4.1</AppVersion>
    <OutputName>ClaudeTimer-$(AppVersion)-win-x64-allusers</OutputName>
    <OutputPath>..\..\artifacts\installer\</OutputPath>
    <DefineConstants>AppVersion=$(AppVersion);PublishDir=..\..\artifacts\folder</DefineConstants>
    <EnableDefaultItems>false</EnableDefaultItems>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE80</SuppressIces>
    <SuppressSpecificWarnings>8602</SuppressSpecificWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.AllUsers.wxs" />
  </ItemGroup>
</Project>