<Window x:Class="ClaudeTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:ClaudeTimer.Behaviors"
        mc:Ignorable="d"
        Title="ClaudeTimer"
        Icon="Logo/Logo.ico"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#01FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Width="22"
                       Height="22"
                       Source="Logo/Logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="ClaudeTimer" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButtonStyle}" Click="Minimize_Click" ToolTip="Minimér">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="HideToTray_Click" ToolTip="Skjul til bakke">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE7F4;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Close_Click" ToolTip="Luk">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="32,20,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Text="Dit Claude-forbrug" />
                    <TextBlock Margin="1,7,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="{Binding StatusText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                                        <Setter Property="Text" Value="{Binding SelectedAccount.StatusText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Indstillinger"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE713;" />
                    </Button>
                    <Button Margin="4,0,0,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Opdatér nu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Faner: kun når Claude Code og Claude Desktop er logget ind på forskellige konti -->
            <ListBox Grid.Row="1"
                     Margin="0,18,0,0"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                     Style="{StaticResource AccountTabsStyle}"
                     Visibility="{Binding ShowTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="2"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SelectedAccount.Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="224"
                                    Margin="0,0,14,14"
                                    Padding="26"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.07" />
                                </Border.Effect>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageCardTemplate}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           Foreground="{StaticResource ErrorBrush}"
                           Text="{Binding SelectedAccount.ErrorText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding SelectedAccount.LastUpdatedText, FallbackValue='Ikke opdateret endnu', TargetNullValue='Ikke opdateret endnu'}" />
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2"
                Margin="0"
                Background="#66000000"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="540"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="28,24,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE713;" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Indstillinger" />
                        <Button Grid.Column="2"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Luk">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE8BB;" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Padding="28,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Token -->
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,8,0,10" Text="TOKEN-KILDE" />
                            <RadioButton GroupName="TokenSource"
                                         Content="Automatisk – alle fundne logins"
                                         IsChecked="{Binding SelectedTokenSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}" />
                            <TextBlock Margin="26,-4,0,10"
                                       Style="{StaticResource SettingsHintStyle}"
                                       Text="Samme konto slås sammen. Forskellige konti vises i hver sin fane." />
                            <RadioButton GroupName="TokenSource"
                                         Content="Kun Claude Code (CLI og VS Code-udvidelsen)"
                                         IsChecked="{Binding SelectedTokenSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ClaudeCode}" />
                            <RadioButton GroupName="TokenSource"
                                         Content="Kun Claude Desktop-appen"
                                         IsChecked="{Binding SelectedTokenSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ClaudeDesktop}" />
                            <RadioButton GroupName="TokenSource"
                                         Content="Kun manuelt indsat token"
                                         IsChecked="{Binding SelectedTokenSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Manual}" />
                            <TextBlock Margin="26,2,0,0" Style="{StaticResource SettingsHintStyle}" Text="{Binding ClaudeCodeCredentialStatus}" />
                            <TextBlock Margin="26,2,0,0" Style="{StaticResource SettingsHintStyle}" Text="{Binding ClaudeDesktopCredentialStatus}" />
                            <TextBlock Margin="26,2,0,0" Style="{StaticResource SettingsHintStyle}" Text="{Binding ManualTokenStatus}" />
                            <TextBlock Margin="26,6,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding AccountsSummaryText}" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,18,0,7" Text="MANUELT OAUTH-TOKEN" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox behaviors:PasswordBoxBinding.IsEnabled="True"
                                             behaviors:PasswordBoxBinding.BoundPassword="{Binding TokenInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PasswordChar="●" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding SaveTokenCommand}"
                                        Content="Gem"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource SettingsHintStyle}"
                                       Text="Krypteres med Windows og kan kun læses af din bruger." />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ForgetTokenCommand}"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Content="Glem gemt token"
                                    Cursor="Hand" />

                            <!-- Opstart -->
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="OPSTART" />
                            <CheckBox Content="Start ClaudeTimer når Windows starter"
                                      IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Margin="26,0,0,10"
                                      Content="Start skjult i systembakken"
                                      IsChecked="{Binding StartHiddenInTray}"
                                      IsEnabled="{Binding StartWithWindows}" />

                            <!-- Administrator -->
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="ADMINISTRATOR" />
                            <CheckBox Content="Kør altid som administrator (også ved opstart)"
                                      IsChecked="{Binding RunAsAdministrator}" />
                            <TextBlock Margin="26,0,0,0"
                                       Style="{StaticResource SettingsHintStyle}"
                                       Text="Windows beder om godkendelse (UAC). Ved automatisk start bruges en planlagt opgave med højeste rettigheder, så der ikke spørges ved hvert logon." />
                            <TextBlock Margin="26,6,0,0"
                                       Style="{StaticResource SettingsHintStyle}"
                                       Text="{Binding ElevationStatusText}" />
                            <Button Margin="26,10,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RestartElevatedCommand}"
                                    Content="Genstart som administrator"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="{Binding CanRestartElevated, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Opdateringer -->
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="OPDATERINGER" />
                            <CheckBox Content="Søg efter nye versioner på GitHub"
                                      IsChecked="{Binding Updates.CheckForUpdates}" />
                            <CheckBox Margin="26,0,0,10"
                                      Content="Installér opdateringer automatisk"
                                      IsChecked="{Binding Updates.AutoInstallUpdates}"
                                      IsEnabled="{Binding Updates.CheckForUpdates}" />
                            <TextBlock Margin="26,0,0,0"
                                       Style="{StaticResource SettingsHintStyle}"
                                       Text="Pakken kontrolleres mod release'ens SHA256-checksum, før den installeres. ClaudeTimer genstarter derefter af sig selv." />
                            <TextBlock Margin="26,8,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding Updates.StatusText}" />
                            <StackPanel Margin="26,10,0,4" Orientation="Horizontal">
                                <Button Command="{Binding Updates.CheckNowCommand}"
                                        Content="Søg nu"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding Updates.InstallCommand}"
                                        Content="Installér opdatering"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding Updates.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding Updates.OpenReleasePageCommand}"
                                        Content="Se på GitHub"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding Updates.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="28,16,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding SettingsMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding SelectedAccount.ErrorText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Command="{Binding CloseSettingsCommand}"
                                Content="Færdig"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>

</Window>
